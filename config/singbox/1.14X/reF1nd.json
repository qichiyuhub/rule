    {"tag": "Google & Github", "type": "selector", "outbounds": ["日本手动", "狮城手动", "香港手动", "美国手动", "德国手动", "澳门手动", "手动选择", "自动选择", "直连"]},
    {"tag": "Microsoft & Apple", "type": "selector", "outbounds": ["日本手动", "狮城手动", "香港手动", "美国手动", "德国手动", "澳门手动", "手动选择", "自动选择", "直连"]},
    {"tag": "Game", "type": "selector", "outbounds": ["日本手动", "狮城手动", "香港手动", "美国手动", "德国手动", "澳门手动", "手动选择", "自动选择", "直连"]},
    {"tag": "漏网之鱼", "type": "selector", "outbounds": ["默认代理", "日本手动", "狮城手动", "香港手动", "美国手动", "德国手动","澳门手动","手动选择", "自动选择", "直连"]},
    {"tag": "日本手动", "type": "selector", "outbounds": null, "use_all_providers": true, "include": "|JP|jp|日本|日|Japan", "exclude": "HK"},
    {"tag": "狮城手动", "type": "selector", "outbounds": null, "use_all_providers": true, "include": "新加坡|坡|狮城|SG|Singapore", "exclude": "日"},
    {"tag": "香港手动", "type": "selector", "outbounds": null, "use_all_providers": true, "include": "港|HK|(?i)Hong", "exclude": "日"},
    {"tag": "美国手动", "type": "selector", "outbounds": null, "use_all_providers": true, "include": "|US|美国|美|United States", "exclude": "日|AUS|RUS"},
    {"tag": "德国手动", "type": "selector", "outbounds": null, "use_all_providers": true, "include": "ge|GE|德国|德|Germany", "exclude": "日|AUS|RUS"},
    {"tag": "澳门手动", "type": "selector", "outbounds": null, "use_all_providers": true, "include": "mac|mo|MAC|MO|澳门|澳|Macau|Macao", "exclude": "日|AUS|RUS"},
    {"tag": "手动选择", "type": "selector", "outbounds": null, "use_all_providers": true, "exclude": "网站|流量|地址|剩余|过期|免费|时间|有效|Traffic|ExpireDate|[0-9]GB|Expire Date"},
    {"tag": "自动选择", "type": "urltest", "outbounds": null, "fallback": { "enabled": true, "max_delay": "200ms" }, "use_all_providers": true, "interval": "10m","exclude":"网站|流量|地址|剩余|过期|免费|时间|有效|Traffic|ExpireDate|[0-9]GB|Expire Date"},
    {"tag": "延迟辅助", "type": "urltest", "outbounds": ["直连"], "url": "http://connect.rom.miui.com/generate_204", "interval": "30m"},
    {"tag": "GLOBAL", "type": "selector", "outbounds": ["默认代理", "Media", "Google & Github", "Microsoft & Apple", "Game", "漏网之鱼", "日本手动", "狮城手动", "香港手动", "美国手动", "德国手动", "澳门手动", "手动选择", "自动选择", "直连"]},
    {"tag": "直连", "type": "direct", "domain_resolver": "ali"}
