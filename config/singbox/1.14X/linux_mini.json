{
  "$schema": "https://sing-box.sagernet.org/schema.json",
  "dns": {
    "servers": [
      {"tag": "local", "type": "local", "prefer_go": true},
      {"tag": "ali", "type": "https", "server": "223.5.5.5"},
      {"tag": "tx", "type": "https", "server": "doh.pub", "domain_resolver": "hosts"},
      {"tag": "google", "type": "https", "server": "8.8.8.8", "detour": "默认代理"},
      {"tag": "fakeip", "type": "fakeip", "inet4_range": "198.19.0.0/16"},
      {"type": "hosts", "tag": "hosts", "predefined": {"doh.pub": ["1.12.12.21", "120.53.53.53"]}}
    ],
    "rules": [
      {"query_type": ["HTTPS", "SVCB"], "action": "reject"},
      {"clash_mode": "Direct", "server": "local"},
      {"clash_mode": "Global", "server": "fakeip"},
      {"rule_set": ["fakeipfilter-cn", "geosite-cn", "geosite-microsoft@cn", "geosite-apple@cn", "geosite-private"], "server": "local"},
      {"rule_set": "fakeipfilter-!cn", "server": "google"},
      {"type": "logical", "mode": "and", "rules": [{"query_type": ["A", "AAAA"]}, {"rule_set": "geosite-geolocation-!cn", "invert": true}], "action": "evaluate", "server": "google", "client_subnet": "223.5.5.0/24","timeout": "2s"},
      {"match_response": true, "rule_set": "geoip-cn", "server": "local"},
      {"query_type": ["A", "AAAA"], "server": "fakeip", "rewrite_ttl": 1}
    ],
    "final": "google",
    "strategy": "ipv4_only", 
    "cache_capacity": 8192,
    "optimistic": {"enabled": true},
    "reverse_mapping": true
  },
  "outbounds": [
    {
      "tag": "默认代理",
      "type": "selector",
      "outbounds": [
        "ZJ-US-AnyTLS",
        "ZJ-US-Hysteria2"
      ]
    },
    {
      "tag": "ZJ-US-AnyTLS",
      "type": "anytls",
      "server": "test.com",
      "server_port": 443,
      "password": "SOTK3rfGTyYsKJT3PKJXrgXADIAOr6N4/zlw=",
      "tls": {
        "enabled": true,
        "server_name": "test.com",
        "insecure": false
      },
      "idle_session_check_interval": "30s",
      "idle_session_timeout": "30s",
      "min_idle_session": 10
    },
    {
      "tag": "ZJ-US-Hysteria2",
      "type": "hysteria2",
      "server": "test.com",
      "server_port": 1443,
      "password": "SOTK3rfGTyYsKJT3PKJXrgXADIAOr6N4/zlw=",
      "obfs": {
        "type": "salamander",
        "password": "SOTK3rfGTyYsKJT3PKJXrgXADIAOr6N4/zlw="
      },
      "tls": {
        "enabled": true,
        "server_name": "test.com",
        "insecure": false
      },
      "up_mbps": 100,
      "down_mbps": 600
    },
    {
      "tag": "直连",
      "type": "direct",
      "domain_resolver": "ali"
    }
  ],
  "http_clients": [
    {"tag": "直连下载", "detour": "直连"}
  ],
  "route": {
    "rules": [
      {"type": "logical", "mode": "and", "rules": [{"port": [53, 853], "invert": true}, {"clash_mode": "Global", "invert": true}, {"type": "logical", "mode": "or", "rules": [{"ip_is_private": true}, {"rule_set": "geoip-cn"}]}], "action": "bypass"},
      {"type": "logical", "mode": "or", "rules": [{"domain_suffix": "push.apple.com"}, {"rule_set": "geoip-telegram"}], "invert": true, "action": "sniff", "sniffer": ["http", "tls", "stun", "quic", "dns"], "timeout": "100ms"},
      {"type": "logical", "mode": "or", "rules": [{"port": 53}, {"protocol": "dns"}], "action": "hijack-dns"},
      {"ip_is_private": true, "outbound": "直连"},
      {"type": "logical", "mode": "or", "rules": [{"port": 853}, {"protocol": ["stun", "quic"]}], "action": "reject", "no_drop": true},
      {"network": "icmp", "action": "resolve"},
      {"network": "icmp", "outbound": "直连"},
      {"clash_mode": "Direct", "outbound": "直连"},
      {"clash_mode": "Global", "outbound": "默认代理"},
      {"rule_set": "geosite-private", "outbound": "直连"},
      {"rule_set": "geosite-category-ai-!cn", "outbound": "默认代理"},
      {"rule_set": "geosite-youtube", "outbound": "默认代理"},
      {"rule_set": "geosite-google", "outbound": "默认代理"},
      {"rule_set": "geosite-github", "outbound": "默认代理"},
      {"rule_set": "geosite-onedrive", "outbound": "默认代理"},
      {"rule_set": "geosite-microsoft@cn", "outbound": "直连"},
      {"rule_set": "geosite-microsoft", "outbound": "默认代理"},
      {"rule_set": "geosite-apple@cn", "outbound": "直连"},
      {"rule_set": "geosite-apple", "outbound": "默认代理"},
      {"rule_set": "geosite-telegram", "outbound": "默认代理"},
      {"rule_set": "geosite-tiktok", "outbound": "默认代理"},
      {"rule_set": "geosite-netflix", "outbound": "默认代理"},
      {"rule_set": "geosite-paypal", "outbound": "默认代理"},
      {"rule_set": "geosite-binance", "outbound": "默认代理"},
      {"rule_set": "geosite-okx", "outbound": "默认代理"},
      {"rule_set": "geosite-category-cryptocurrency", "outbound": "默认代理"},
      {"rule_set": "geosite-steam@cn", "outbound": "直连"},
      {"rule_set": "geosite-steam", "outbound": "默认代理"},
      {"rule_set": "geosite-geolocation-!cn", "outbound": "默认代理"},
      {"inbound": "mixed-in", "action": "resolve"},
      {"rule_set": "geoip-telegram", "outbound": "默认代理"},
      {"rule_set": "geoip-cn", "outbound": "直连"}
    ],
    "rule_set": [
      {"tag": ["fakeipfilter-cn", "fakeipfilter-!cn"], "type": "remote", "format": "source", "url": "https://gh-proxy.com/https://raw.githubusercontent.com/qichiyuhub/rule/refs/heads/main/rules/{tag}.json"},
      {"tag": ["geosite-category-ai-!cn", "geosite-youtube", "geosite-google", "geosite-github", "geosite-onedrive", "geosite-microsoft", "geosite-microsoft@cn","geosite-apple", "geosite-apple@cn", "geosite-telegram", "geosite-tiktok", "geosite-netflix", "geosite-paypal", "geosite-binance", "geosite-okx", "geosite-category-cryptocurrency", "geosite-steam@cn", "geosite-steam", "geosite-geolocation-!cn", "geosite-cn", "geosite-private"], "type": "remote", "format": "binary", "url": "https://gh-proxy.com/https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/{tag}.srs"},
      {"tag": "geoip-telegram", "type": "remote", "format": "binary", "url": "https://gh-proxy.com/https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/sing/geo/geoip/telegram.srs"},
      {"tag": "geoip-cn", "type": "remote", "format": "binary", "url": "https://gh-proxy.com/https://raw.githubusercontent.com/SagerNet/sing-geoip/rule-set/geoip-cn.srs"}
    ],
    "final": "默认代理",
    "default_http_client": "直连下载",
    "auto_detect_interface": true,
    "default_domain_resolver": {"server": "ali"}
  },
  "inbounds": [
    {
      "tag": "tun-in",
      "type": "tun",
      "address": [
        "172.19.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "auto_route": true,
      "auto_redirect": true
    },
    {
      "tag": "mixed-in",
      "type": "mixed",
      "listen": "0.0.0.0",
      "listen_port": 7890
    }
  ],
  "services": [
    {
      "type": "api",
      "listen": "0.0.0.0",
      "listen_port": 9090,
      "secret": "passwd",
      "dashboard": {
        "enabled": true,
        "path": "/etc/sing-box/dashboard"
      }
    }
  ],
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "/etc/sing-box/cache.db",
      "store_dns": true
    },
    "clash_api": {
      "external_controller": "0.0.0.0:9095",
      "external_ui": "/etc/sing-box/ui",
      "secret": "passwd",
      "default_mode": "Rule"
    }
  },
  "certificate": {
    "store": "chrome"
  },
  "ntp": {
    "enabled": true,
    "server": "time.apple.com"
  },
  "log": {
    "disabled": false,
    "level": "info",
    "timestamp": true
  }
}

